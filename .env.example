# Neon pooled connection string. Never expose it in browser code.
DATABASE_URL=postgresql://user:password@example-pooler.neon.tech/neondb?sslmode=require

# Use a long, unique password for the application login.
APP_PASSWORD=replace-with-a-long-password

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
